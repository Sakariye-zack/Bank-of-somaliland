# Set to "production" on the real server — this flips the refresh-token cookie
# to secure:true (HTTPS-only), among other environment-sensitive behavior.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://bos_app:bos_dev_password@localhost:5432/bank_of_somaliland
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=60m
JWT_REFRESH_TTL=7d
CORS_ORIGIN_PUBLIC=http://localhost:5173
CORS_ORIGIN_ADMIN=http://localhost:5174
